# Signing key for session cookies. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Local default is a SQLite file. In production use Turso (libSQL) free tier:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/ronaq.db
